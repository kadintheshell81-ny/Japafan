# JAPAFAN - ENVIRONMENT VARIABLES REFERENCE
# Rename this file to '.env' and populate with your own project credentials.

# 1. Your Supabase Project API URL (found in Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# 2. Your Supabase Anon Public Key (found in Project Settings -> API)
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here
